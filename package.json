{
  "name": "@aitt/map",
  "version": "0.1.0",
  "description": "Map kit for AI Transportation Tools: California basemap, Signal Flow style, layers, measure",
  "type": "module",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "public/fonts",
    "public/sprites",
    "src"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "basemap": "node scripts/get-basemap.mjs",
    "test": "vitest run && playwright test",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "upload": "node scripts/upload-r2.mjs",
    "deploy": "node scripts/deploy-pages.mjs"
  },
  "dependencies": {
    "@protomaps/basemaps": "^5.7.2",
    "@turf/area": "^7.4.0",
    "@turf/length": "^7.4.0",
    "maplibre-gl": "^6.18.0",
    "pmtiles": "^4.5.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/lib-storage": "^3.1169.0",
    "@maplibre/maplibre-gl-style-spec": "^26.8.0",
    "@playwright/test": "^1.65.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.163.0"
  }
}
